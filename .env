# Docker Compose Environment Variables for Quan Ly Lop Hoc

# PostgreSQL Database Configuration
POSTGRES_DB=quanlylophoch_db
POSTGRES_USER=qlhc_user
POSTGRES_PASSWORD=your_secure_password_here # IMPORTANT: Change this to a strong, unique password

# Application Port Configuration
API_PORT=8080 # Port for the .NET API
WEB_PORT=3000 # Port for the React Vite frontend (Nginx)

# You can add other environment variables here as needed for your application
# For example, JWT secret, external service URLs, etc.
# JWT_SECRET=your_jwt_secret