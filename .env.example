# This file contains example environment variables.
# Copy this to a new file named '.env' and fill in your actual values.
# DO NOT commit '.env' to your version control for security reasons.

# Database Configuration
DB_NAME=CourseManagementDB
DB_USER=course_admin
DB_PASSWORD=SecurePassword123ChangeMe!

# API Configuration
ASPNETCORE_ENVIRONMENT=Development # Set to Production for production deployments

# Web Configuration
# VITE_API_BASE_URL:
# - For local development (accessing API via host's exposed port 8080): http://localhost:8080
# - For container-to-container communication (if frontend within Docker talks to API service directly): http://api:8080
VITE_API_BASE_URL=http://localhost:8080