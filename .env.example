# Database Configuration
POSTGRES_DB=student_management_db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

# API Configuration
ASPNETCORE_ENVIRONMENT=Development

# Web Configuration (Frontend)
# This URL should point to your API service.
# If running locally via docker-compose, this might be localhost:8080 (if exposed).
# If web service directly calls api service internally, it would be http://api:8080
# For simplicity, using localhost for local testing.
# In a production setup, this would be your actual API domain/IP.
VITE_API_BASE_URL=http://localhost:8080